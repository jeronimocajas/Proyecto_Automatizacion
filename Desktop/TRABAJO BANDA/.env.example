# .env - Configuración del sistema de auxilios CECAR
# Copia este archivo como .env y completa los valores reales

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://auxilios_user:TU_PASSWORD_AQUI@localhost:5432/auxilios_cecar

# Seguridad - genera una clave con: openssl rand -hex 32
SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_CON_openssl_rand_hex_32

# Anthropic - Agente IA
ANTHROPIC_API_KEY=sk-ant-...

# SMTP - Correo institucional CECAR
SMTP_HOST=smtp.cecar.edu.co
SMTP_PORT=587
SMTP_USER=noreply@cecar.edu.co
SMTP_PASSWORD=TU_PASSWORD_SMTP
SMTP_TLS=true
CORREO_DESTINO_BIENESTAR=bienestar@cecar.edu.co

# Almacenamiento de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS - dominios permitidos (separados por coma en lista)
ALLOWED_ORIGINS=["https://tu-dominio.cecar.edu.co","http://localhost:3000"]

# Reglas de negocio
PROMEDIO_MINIMO=3.7
MAX_INTENTOS=2
TOKEN_EXPIRE_HOURS=24
